# ============================================================
#  Book Store backend — environment variable template
#  Copy this file to `.env` and fill in the real values.
# ============================================================

# PostgreSQL connection string.
# Get the full URL from your database provider's dashboard
# (e.g. Supabase -> Project Settings -> Database -> Connection string).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# NOTE: If you leave this as the PASSWORD_HERE placeholder (or empty),
# the backend automatically falls back to a LOCAL SQLite database
# (bookstore.db) so the app still runs for development.
DATABASE_URL=postgresql://bookstore_r6c6_user:PASSWORD_HERE@YOUR_DATABASE_HOST:5432/bookstore_r6c6

# JWT signing key — change this in production!
SECRET_KEY=your-super-secret-key-change-me-in-production
